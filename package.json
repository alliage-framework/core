{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna exec --include-dependencies --stream -- sh \\$LERNA_ROOT_PATH/scripts/build.sh",
    "clean": "lerna exec --include-dependencies --stream -- rm -rf dist",
    "lint": "eslint . --ext .js --ext .ts",
    "lint:fix": "yarn lint --silent -- --fix",
    "test:unit": "NODE_ENV=test vitest run --coverage",
    "test:integration": "NODE_ENV=test vitest run --config ./integration-tests/vitest.config.ts",
    "test": "yarn lint && yarn test:unit && yarn test:integration",
    "release": "lerna version --conventional-commits --yes",
    "publish": "lerna publish from-package --yes",
    "sandbox": "ts-node test-utils/sandbox/index.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@alliage/framework": "^1.0.0-beta.4",
    "@alliage/sandbox": "^1.0.0-beta.3",
    "@eslint/js": "^9.24.0",
    "@types/fs-extra": "11.0.4",
    "@types/node": "^22.14.1",
    "@types/yaml": "^1.9.7",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lerna": "^8.2.2",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "fs-extra": "11.3.0",
    "glob": "^11.0.1",
    "lodash.get": "^4.4.2",
    "yaml": "^2.7.1"
  }
}
